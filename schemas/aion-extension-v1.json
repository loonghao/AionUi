{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aionui.dev/schemas/aion-extension-v1.json",
  "title": "AionUI Extension Manifest",
  "description": "Configuration file for AionUI extensions (aion-extension.json)",
  "type": "object",
  "required": ["name", "displayName", "version", "contributes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for IDE auto-completion"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 2,
      "maxLength": 64,
      "description": "Unique extension identifier (kebab-case). Cannot start with reserved prefixes: aion-, internal-, builtin-, system-"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Display name shown in the UI"
    },
    "displayNameI18n": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Localized display names"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$",
      "description": "Semantic version (e.g., 1.0.0, 1.0.0-beta.1)"
    },
    "description": {
      "type": "string",
      "description": "Short description of the extension"
    },
    "descriptionI18n": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Localized descriptions"
    },
    "author": {
      "type": "string",
      "description": "Extension author"
    },
    "icon": {
      "type": "string",
      "description": "Relative path to extension icon (SVG/PNG)"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Extension homepage URL"
    },
    "dependencies": {
      "type": "object",
      "description": "Extension dependencies: { extensionName: versionRange }. Version range uses semver format (e.g., ^1.0.0, ~2.1.0)",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\^~]?\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$"
      }
    },
    "engine": {
      "type": "object",
      "description": "Engine compatibility requirements",
      "properties": {
        "aionui": {
          "type": "string",
          "pattern": "^[\\^~]?\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$",
          "description": "Compatible AionUI core version range"
        }
      }
    },
    "contributes": {
      "type": "object",
      "description": "Extension contributions",
      "properties": {
        "acpAdapters": {
          "type": "array",
          "description": "ACP adapter definitions (CLI, WebSocket, or HTTP agents)",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "description": "Unique adapter identifier" },
              "name": { "type": "string", "description": "Display name" },
              "nameI18n": { "type": "object", "additionalProperties": { "type": "string" } },
              "description": { "type": "string", "description": "Short description" },
              "descriptionI18n": { "type": "object", "additionalProperties": { "type": "string" } },
              "cliCommand": { "type": "string", "description": "CLI command name for detection (optional for non-CLI agents)" },
              "defaultCliPath": { "type": "string", "description": "Full CLI path or npx command" },
              "acpArgs": { "type": "array", "items": { "type": "string" }, "description": "ACP mode arguments" },
              "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Environment variables" },
              "icon": { "type": "string", "description": "Relative path to icon" },
              "authRequired": { "type": "boolean" },
              "supportsStreaming": { "type": "boolean" },
              "connectionType": { "type": "string", "enum": ["cli", "websocket", "http"], "default": "cli", "description": "Transport type: cli (spawn process), websocket, http" },
              "endpoint": { "type": "string", "description": "WebSocket/HTTP endpoint URL (for non-CLI agents)" },
              "models": { "type": "array", "items": { "type": "string" }, "description": "Available models for this adapter" },
              "yoloMode": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["session", "global"] },
                  "sessionMode": { "type": "string" }
                }
              },
              "healthCheck": {
                "type": "object",
                "required": ["versionCommand"],
                "properties": {
                  "versionCommand": { "type": "string" },
                  "timeout": { "type": "number" }
                }
              }
            }
          }
        },
        "mcpServers": {
          "type": "array",
          "description": "MCP server definitions",
          "items": {
            "type": "object",
            "required": ["name", "transport"],
            "properties": {
              "name": { "type": "string", "description": "Server name" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean", "default": true },
              "transport": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "enum": ["stdio", "sse", "http", "streamable_http"] },
                  "command": { "type": "string", "description": "Command for stdio transport" },
                  "args": { "type": "array", "items": { "type": "string" } },
                  "env": { "type": "object", "additionalProperties": { "type": "string" } },
                  "url": { "type": "string", "description": "URL for sse/http/streamable_http transport" },
                  "headers": { "type": "object", "additionalProperties": { "type": "string" } }
                }
              }
            }
          }
        },
        "assistants": {
          "type": "array",
          "description": "Custom assistant preset definitions",
          "items": {
            "type": "object",
            "required": ["id", "name", "presetAgentType", "contextFile"],
            "properties": {
              "id": { "type": "string", "description": "Unique assistant identifier" },
              "name": { "type": "string", "description": "Display name" },
              "nameI18n": { "type": "object", "additionalProperties": { "type": "string" } },
              "description": { "type": "string" },
              "descriptionI18n": { "type": "object", "additionalProperties": { "type": "string" } },
              "avatar": { "type": "string", "description": "Emoji or image path" },
              "presetAgentType": { "type": "string", "enum": ["gemini", "claude", "codex", "codebuddy", "opencode"] },
              "contextFile": { "type": "string", "description": "Relative path to prompt/rules Markdown file" },
              "contextFileI18n": { "type": "object", "additionalProperties": { "type": "string" } },
              "models": { "type": "array", "items": { "type": "string" } },
              "enabledSkills": { "type": "array", "items": { "type": "string" } },
              "prompts": { "type": "array", "items": { "type": "string" } },
              "promptsI18n": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
            }
          }
        },
        "skills": {
          "type": "array",
          "description": "Skill pack definitions",
          "items": {
            "type": "object",
            "required": ["name", "file"],
            "properties": {
              "name": { "type": "string", "description": "Skill name" },
              "description": { "type": "string" },
              "file": { "type": "string", "description": "Relative path to SKILL.md" }
            }
          }
        },
        "channelPlugins": {
          "type": "array",
          "description": "Channel bot plugin definitions (Phase 2)",
          "items": {
            "type": "object",
            "required": ["type", "name", "entryPoint"],
            "properties": {
              "type": { "type": "string", "description": "Platform type identifier" },
              "name": { "type": "string" },
              "nameI18n": { "type": "object", "additionalProperties": { "type": "string" } },
              "description": { "type": "string" },
              "entryPoint": { "type": "string", "description": "Relative path to JS module" },
              "credentialFields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "label", "type"],
                  "properties": {
                    "key": { "type": "string" },
                    "label": { "type": "string" },
                    "type": { "type": "string", "enum": ["text", "password", "select", "number", "boolean"] },
                    "required": { "type": "boolean" },
                    "options": { "type": "array", "items": { "type": "string" } },
                    "default": {}
                  }
                }
              },
              "configFields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "label", "type"],
                  "properties": {
                    "key": { "type": "string" },
                    "label": { "type": "string" },
                    "type": { "type": "string", "enum": ["text", "password", "select", "number", "boolean"] },
                    "required": { "type": "boolean" },
                    "options": { "type": "array", "items": { "type": "string" } },
                    "default": {}
                  }
                }
              }
            }
          }
        },
        "webui": {
          "type": "object",
          "description": "WebUI extension contributions (Phase 3)",
          "properties": {
            "apiRoutes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "entryPoint"],
                "properties": {
                  "path": { "type": "string" },
                  "entryPoint": { "type": "string" },
                  "description": { "type": "string" },
                  "auth": { "type": "boolean", "default": true }
                }
              }
            },
            "wsHandlers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["namespace", "entryPoint"],
                "properties": {
                  "namespace": { "type": "string" },
                  "entryPoint": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "middleware": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["entryPoint"],
                "properties": {
                  "entryPoint": { "type": "string" },
                  "description": { "type": "string" },
                  "applyTo": { "type": "string", "default": "/**" },
                  "order": { "type": "string", "enum": ["before", "after"], "default": "before" }
                }
              }
            },
            "staticAssets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["urlPrefix", "directory"],
                "properties": {
                  "urlPrefix": { "type": "string" },
                  "directory": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "themes": {
          "type": "array",
          "description": "CSS theme definitions (Phase 4)",
          "items": {
            "type": "object",
            "required": ["id", "name", "file"],
            "properties": {
              "id": { "type": "string", "description": "Unique theme identifier" },
              "name": { "type": "string", "description": "Theme display name" },
              "nameI18n": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Localized theme names" },
              "file": { "type": "string", "description": "Relative path to CSS file" },
              "cover": { "type": "string", "description": "Relative path to theme preview image" }
            }
          }
        }
      }
    }
  }
}
